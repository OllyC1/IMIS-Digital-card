# Public production origin used in permanent card, QR and NFC URLs.
NEXT_PUBLIC_SITE_URL=https://cards.imisglobal.com

# Supabase is used only from the server. Never prefix the secret with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_server_secret

# The sole administrator account. Generate the password hash with:
# npm run hash-password -- "your strong password"
ADMIN_EMAIL=admin@imisglobal.com
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$replace_with_salt$replace_with_hash

# At least 32 random bytes. Example: openssl rand -base64 48
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
